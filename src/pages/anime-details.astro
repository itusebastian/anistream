---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Anime Details | AniStream"
    description="Explore anime information, genres, synopsis, production details, and trailers."
    activePage="browse"
    ogType="video.tv_show"
>
        <section class="cinematic-section">
            <div class="backdrop-banner-wrapper">
                <img id="bannerImage" class="banner-image" src="https://cdn.myanimelist.net/images/anime/1208/94745.jpg" alt="Fullmetal Alchemist: Brotherhood Banner">
            </div>

            <div class="backdrop-fade-bottom"></div>
            <div class="backdrop-fade-left"></div>

            <div class="details-content-container">
                
                <nav class="breadcrumb-nav reveal-up">
                    <a href="index.html">Home</a>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="breadcrumb-arrow"><path d="m9 18 6-6-6-6"/></svg>
                    <a href="browse.html">Browse</a>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="breadcrumb-arrow"><path d="m9 18 6-6-6-6"/></svg>
                    <span id="breadcrumbTitle">Fullmetal Alchemist: Brotherhood</span>
                </nav>

                <div class="details-grid-layout">
        
                    <div class="reveal-up reveal-delay-1">
                        <div class="details-poster-wrapper">
                            <img id="posterImage" class="poster-image" src="https://cdn.myanimelist.net/images/anime/1208/94745.jpg" alt="Fullmetal Alchemist: Brotherhood Poster">
                        </div>

                        <div class="details-actions-wrapper">
                            <button class="cta-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-sm"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
                                Watch Trailer
                            </button>
                        </div>
                    </div>

                    
                    <div class="details-info-column">

                        <div class="reveal-up reveal-delay-2">
                            <h1 id="titleEn">Fullmetal Alchemist: Brotherhood</h1>
                            <p id="titleJp">鋼の錬金術師 FULLMETAL ALCHEMIST</p>
                        </div>
                        
                        <div id="metaBadges" class="reveal-up reveal-delay-3 badges-flex-row"></div>
    
                        <div id="genreTags" class="reveal-up reveal-delay-3 tags-flex-row"></div>

                        <div class="reveal-up reveal-delay-4">
                            <h2 class="section-title">
                            <span class="accent-line-indicator"></span>
                            Synopsis
                            </h2>
                            <p id="synopsis">Loading...</p>
                        </div>

                        <div class="reveal-up reveal-delay-5">
                            <h2 class="section-title">
                                <span class="accent-line-indicator"></span>
                                Production Details
                            </h2>
                            <div class="production-table-card">
                                <div id="productionGrid"></div>
                            </div>
                        </div>
    
                    </div>
                </div>
            </div>
        </section>

        <!-- Video Trailer Modal Wrapper -->
        <div id="trailerModal" class="modal-overlay" style="display: none;">
            <div class="modal-container">
                <button id="modalClose" class="modal-close-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-lg"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
                <div class="modal-video-wrapper">
                    <!-- The dynamic iframe will be injected here -->
                    <div id="trailerVideoContainer"></div>
                </div>
            </div>
        </div>
</BaseLayout>

<script>
    import { initAnimeDetails } from '../../scripts/anime-details.mjs';

    initAnimeDetails();
</script>
