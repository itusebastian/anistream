---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Search Anime | AniStream"
    description="Search the anime catalog by title and discover your next favorite series."
    mainClass="search-page-main"
>
        <div class="search-page-container">

            <div class="page-heading-wrapper">
                <div class="search-heading-title-row">
                    <div class="section-line"></div>
                    <h1 class="page-main-title">Explore Anime Catalog</h1>
                </div>
                <p class="page-subtitle">Search thousands of titles from every genre and era</p>
            </div>

            <div class="search-bar-wrapper">
                <div class="search-input-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon-left"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
                    <input 
                        id="searchInput"
                        type="text"
                        placeholder="Search by title..."
                        autocomplete="off"
                    >
                    <button id="clearBtn" class="clear-btn hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
            </div>

            <div id="resultsBar" class="result-count-bar hidden">
                <div class="result-count-left">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
                    <span class="result-count-text"><span id="resultsCount">0</span> results found</span>
                </div>
                <button class="result-clear-action">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    <span>Clear</span>
                </button>
            </div>

            <div id="zeroState" class="state-container flex">
                <div class="zero-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                </div>
                <h2 class="state-title">Find Your Next Favorite Story</h2>
                <p class="state-description">
                Search by title names — discover anime from every corner of the catalog.
                </p>
            </div>

            <div id="noResults" class="state-container hidden">
                <div class="no-results-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                </div>
                <h2 class="state-title">No Matches Found</h2>
                <p class="state-description">
                    We couldn't find anything for "<span id="noResultsQuery" class="query-highlight"></span>". Try different keywords or check the spelling.
                </p>
            </div>

            <div id="animeGrid" class="anime-grid search-results-grid hidden"></div>


        </div>
</BaseLayout>

<script>
    import { initAnimeSearch } from '../../scripts/search.mjs';

    initAnimeSearch();
</script>
