---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Browse Anime Seasons | AniStream"
    description="Explore anime airing this season and filter by genre, source, and rating."
    activePage="browse"
    mainClass="page-main"
>
        <div class="page-container">

            <div class="header-wrapper">
                <div class="heading-title-row">
                    <div class="section-line"></div>
                    <h1 id="browseTitle" class="main-title">Season</h1>
                </div>
                <p class="page-subtitle">Explore the latest and most popular series currently airing</p>
            </div>

            <div class="filter-toolbar">
                <div class="filter-group-left">
                
                    <div class="custom-select-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-icon-left"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                        <select id="filterGenre">
                            <option value="all">All Genres</option>
                            <option value="action">Action</option>
                            <option value="fantasy">Fantasy</option>
                            <option value="comedy">Comedy</option>
                            <option value="drama">Drama</option>
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-arrow-right"><path d="m6 9 6 6 6-6"/></svg>
                    </div>

                    <div class="custom-select-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-icon-left"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
                        <select id="filterSource">
                            <option value="all">All Sources</option>
                            <option value="manga">Manga Adaptations</option>
                            <option value="light novel">Light Novels</option>
                            <option value="original">Original Works</option>
                            <option value="other">Other (Games/Web-toons)</option>
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-arrow-right"><path d="m6 9 6 6 6-6"/></svg>
                    </div>

                </div>

                <div class="filter-group-right">

                    <div class="custom-select-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-icon-left"><path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/></svg>
                        <select id="filterSort">
                            <option value="popular">Most Popular</option>
                            <option value="rated">Highest Rated</option>
                            <option value="az">Alphabetical (A-Z)</option>
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="select-arrow-right"><path d="m6 9 6 6 6-6"/></svg>
                    </div>

                </div>
            </div>

            <div id="animeGrid" class="anime-grid grid-layout"></div>

        </div>
</BaseLayout>

<script>
    import { initBrowseCatalog } from '../../scripts/browse-catalog.mjs';

    initBrowseCatalog();
</script>
